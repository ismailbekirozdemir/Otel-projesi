  <property name="styleSheet">
   <string notr="true">/* Dialog Ana Arka Planı */
QDialog {
    background-color: #0f172a;
    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
}

/* Başlık Çerçevesi */
QFrame#dialog_header {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
}

QLabel#lbl_dialog_title {
    color: #f8fafc;
    font-size: 15pt;
    font-weight: 700;
}

QLabel#lbl_dialog_subtitle {
    color: #94a3b8;
    font-size: 9pt;
}

/* Form Kartı */
QFrame#form_card {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
}

/* Bölüm Başlıkları */
QLabel.section_title {
    color: #38bdf8;
    font-size: 9pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: transparent;
}

/* Alan Etiketleri */
QLabel.field_label {
    color: #cbd5e1;
    font-size: 9.5pt;
    font-weight: 600;
    background: transparent;
}

/* Girdi Kutuları */
QLineEdit, QDateEdit {
    background-color: #0f172a;
    color: #f8fafc;
    border: 1.5px solid #334155;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 10pt;
    min-height: 22px;
}

QLineEdit:focus, QDateEdit:focus {
    border: 1.5px solid #3b82f6;
    background-color: #0f172a;
}

QLineEdit::placeholder {
    color: #64748b;
}

/* QDateEdit Özelleştirmesi */
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid #334155;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    background-color: #1e293b;
}

/* Takvim Açılır Penceresi */
QCalendarWidget QWidget {
    background-color: #1e293b;
    color: #f8fafc;
}

QCalendarWidget QToolButton {
    background-color: #0f172a;
    color: #f8fafc;
    border-radius: 4px;
    padding: 4px;
}

QCalendarWidget QMenu {
    background-color: #1e293b;
    color: #f8fafc;
}

/* Ayırıcı Çizgi */
QFrame#line_separator {
    background-color: #334155;
    max-height: 1px;
}

/* Butonlar */
QPushButton#btn_kaydet {
    background-color: #2563eb;
    color: #ffffff;
    border: 1px solid #3b82f6;
    border-radius: 8px;
    font-size: 10.5pt;
    font-weight: 700;
    padding: 10px 20px;
    min-height: 24px;
}

QPushButton#btn_kaydet:hover {
    background-color: #1d4ed8;
    border-color: #60a5fa;
}

QPushButton#btn_kaydet:pressed {
    background-color: #1e40af;
}

QPushButton#btn_iptal {
    background-color: #334155;
    color: #e2e8f0;
    border: 1px solid #475569;
    border-radius: 8px;
    font-size: 10pt;
    font-weight: 600;
    padding: 10px 18px;
    min-height: 24px;
}

QPushButton#btn_iptal:hover {
    background-color: #475569;
    color: #ffffff;
}

QPushButton#btn_iptal:pressed {
    background-color: #1e293b;
}
   </string>
