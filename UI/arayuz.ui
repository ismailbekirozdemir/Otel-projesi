  <property name="styleSheet">
   <string notr="true">/* Ana Pencere ve Temel Bileşenler */
QMainWindow {
    background-color: #0f172a;
    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
}

QWidget#centralwidget {
    background-color: #0f172a;
}

/* Üst Başlık Kartı */
QFrame#header_frame {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
}

QLabel#lbl_main_title {
    color: #f8fafc;
    font-size: 18pt;
    font-weight: 700;
}

QLabel#lbl_main_subtitle {
    color: #94a3b8;
    font-size: 9.5pt;
}

/* Üst Durum Rozetleri */
QLabel.badge_stat {
    background-color: #0f172a;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 9pt;
    font-weight: 600;
    color: #cbd5e1;
}

/* Oda Kartları */
QFrame.room_card {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 14px;
}

QFrame.room_card:hover {
    border: 1px solid #3b82f6;
}

/* Kart Başlığı */
QLabel.room_number {
    color: #f8fafc;
    font-size: 14pt;
    font-weight: 700;
    background: transparent;
    border: none;
}

QLabel.room_status {
    background-color: #0f172a;
    border-radius: 8px;
    padding: 4px 12px;
    font-size: 9.5pt;
    font-weight: 700;
    border: 1px solid #334155;
}

/* Bilgi Kutusu ve Satırları */
QFrame.info_box {
    background-color: #0f172a;
    border: 1px solid #293548;
    border-radius: 10px;
}

QLabel.info_text {
    color: #cbd5e1;
    font-size: 10pt;
    background: transparent;
    border: none;
}

QLabel.info_text_price {
    color: #38bdf8;
    font-size: 10.5pt;
    font-weight: 700;
    background: transparent;
    border: none;
}

QLabel.info_text_date {
    color: #94a3b8;
    font-size: 9.5pt;
    background: transparent;
    border: none;
}

/* İşlem Butonu */
QPushButton.btn_action {
    background-color: #2563eb;
    color: #ffffff;
    border: 1px solid #3b82f6;
    border-radius: 8px;
    font-size: 10pt;
    font-weight: 600;
    padding: 8px 16px;
    min-height: 36px;
}

QPushButton.btn_action:hover {
    background-color: #1d4ed8;
    border-color: #60a5fa;
}

QPushButton.btn_action:pressed {
    background-color: #1e40af;
}

/* Menü ve Durum Çubuğu */
QMenuBar {
    background-color: #0f172a;
    color: #94a3b8;
    border-bottom: 1px solid #1e293b;
}

QMenuBar::item:selected {
    background-color: #1e293b;
    color: #f8fafc;
}

QStatusBar {
    background-color: #0f172a;
    color: #64748b;
    border-top: 1px solid #1e293b;
}
   </string>
